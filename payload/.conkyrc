conky.config = {

-- =====================================================
-- USER SETTINGS — An illustration to customise Conky
-- =====================================================
--
-- Conky window alignment
-- alignment options: top_right, top_left, top_middle,
--                    bottom_right, bottom_left, bottom_middle,
--                    middle_right, middle_left, middle_middle
--	alignment = 'top_right',
--	gap_x = 25,   -- horizontal gap from screen edge (pixels)
--	gap_y = 05,   -- vertical gap from screen edge (pixels)
--
-- =====================================================

-- Conky transparency settings for Gnome specific environment
	own_window = true,
	own_window_type = 'normal',
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
	own_window_argb_visual = true,
	own_window_argb_value = 255,

-- Conky general settings
	background = false, --[[If true, conky will autostart on login]]
	update_interval = 1,
	double_buffer = true,
	no_buffers = true,

-- Conky window specifications
	own_window_title = 'Universe',
	--own_window = true,
	--own_window_type = 'normal',
	--own_window_transparent = true,
	--own_window_argb_visual = true,
	--own_window_argb_value = 0
	--own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
	minimum_width = 300,

-- Conky window alignment
	alignment = 'middle_right',
	gap_x = 25,
	gap_y = 05,
	border_inner_margin = 15,
	border_outer_margin = 0,

-- Conky graphics settings
	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	uppercase = false,

-- Conky text settings
	use_xft = true,
	xftalpha = 0,
	font = 'Open Sans Light:size=10',
	override_utf8_locale = true,
	imlib_cache_size = 0,

-- Conky color scheme
	default_color = '#FFFFFF',
	color1 = '#FFFFFF',
	color2 = '#FFFFFF',
	color3 = '#FFFFFF',
	color4 = '#FFFFFF',
	color5 = '#FFFFFF',
	color6 = '#FFFFFF',
	color7 = '#333333',

};

conky.text = [[
${execi 300 bash ~/.conky-google-now/conky-weather-fetch.sh}${font Open Sans Light:size=15}${execi 300 cat ~/.cache/weather-data/city}, ${execi 300 cat ~/.cache/weather-data/region}, ${execi 300 cat ~/.cache/weather-data/country}${font}
${font Open Sans Light:size=70}${alignr}${execi 300 cat ~/.cache/weather-data/temp}°${font}${voffset -35}
${image ~/.cache/weather-data/condition-icon.png -p 5,40 -s 74x74}
${execi 300 cat ~/.cache/weather-data/condition}
${image ~/.conky-google-now/wind.png -p 0,135 -s 15x15}${goto 35}${execi 300 cat ~/.cache/weather-data/wind} ${execi 300 cat ~/.cache/weather-data/wind_unit}
${image ~/.conky-google-now/humidity.png -p 0,155 -s 15x15}${goto 35}${execi 300 cat ~/.cache/weather-data/humidity}%
${image ~/.conky-google-now/wind.png -p 18,135 -s 1x1}${goto 35}
${goto 18}${execi 300 cat ~/.cache/weather-data/fc0_day}${goto 88}${execi 300 cat ~/.cache/weather-data/fc1_day}${goto 158}${execi 300 cat ~/.cache/weather-data/fc2_day}${goto 228}${execi 300 cat ~/.cache/weather-data/fc3_day}${goto 298}${execi 300 cat ~/.cache/weather-data/fc4_day}
${image ~/.cache/weather-data/forecast-0.png -p 0,215 -s 30x30}${image ~/.cache/weather-data/forecast-1.png -p 70,215 -s 30x30}${image ~/.cache/weather-data/forecast-2.png -p 140,215 -s 30x30}${image ~/.cache/weather-data/forecast-3.png -p 210,215 -s 30x30}${image ~/.cache/weather-data/forecast-4.png -p 280,215 -s 30x30}${voffset +45}${goto 20}${execi 300 cat ~/.cache/weather-data/fc0_hi}°${goto 90}${execi 300 cat ~/.cache/weather-data/fc1_hi}°${goto 160}${execi 300 cat ~/.cache/weather-data/fc2_hi}°${goto 230}${execi 300 cat ~/.cache/weather-data/fc3_hi}°${goto 300}${execi 300 cat ~/.cache/weather-data/fc4_hi}°
${goto 20}${execi 300 cat ~/.cache/weather-data/fc0_lo}°${goto 90}${execi 300 cat ~/.cache/weather-data/fc1_lo}°${goto 160}${execi 300 cat ~/.cache/weather-data/fc2_lo}°${goto 230}${execi 300 cat ~/.cache/weather-data/fc3_lo}°${goto 300}${execi 300 cat ~/.cache/weather-data/fc4_lo}°
${color7}${hr}${color}
\
#---Clock+Date---#
${font Raleway:weight=Light:size=28}${voffset +20}${alignc}${execi 300 bash ~/.conky-google-now/conky_timezone.sh date}
${font Raleway:weight=Light:size=72}${alignc}${execi 300 bash ~/.conky-google-now/conky_timezone.sh hour}${alignc}:${alignc}${execi 300 bash ~/.conky-google-now/conky_timezone.sh min}
${voffset -60}${color7}${hr}${color}
\
#---Resource Usage---#
${font Spinebiting:size=13}${voffset -120}
Utime:$alignr$uptime
RAM:$alignr$mem
#Swp:${offset 89}${swap}
HDD:$alignr${fs_used}
#CPU:$alignr${cpu cpu0}%
\
#---Network Statistics---#
${if_existing /proc/net/route wlp0s20f3}
${color1}Up:${color} ${color3}${upspeed wlp0s20f3}${color}${alignr}${color1}Down:${color} ${color3}${downspeed wlp0s20f3}${color}
${upspeedgraph wlp0s20f3 75,135 333333 333333}${alignr}${downspeedgraph wlp0s20f3 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup wlp0s20f3}${color}${alignr}${color1}Received:${color} ${color2}${totaldown wlp0s20f3}${color}
${else}${if_existing /proc/net/route wlan1}
${color1}Up:${color} ${color3}${upspeed wlan1}${color}${alignr}${color1}Down:${color} ${color3}${downspeed wlan1}${color}
${upspeedgraph wlan1 75,135 333333 333333}${alignr}${downspeedgraph wlan1 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup wlan1}${color}${alignr}${color1}Received:${color} ${color2}${totaldown wlan1}${color}
${else}${if_existing /proc/net/route enp0s3}
${color1}Up:${color} ${color3}${upspeed enp0s3}${color}${alignr}${color1}Down:${color} ${color3}${downspeed enp0s3}${color}
${upspeedgraph enp0s3 75,135 333333 333333}${alignr}${downspeedgraph enp0s3 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup enp0s3}${color}${alignr}${color1}Received:${color} ${color2}${totaldown enp0s3}${color}
${else}${if_existing /proc/net/route eth1}
${color1}Up:${color} ${color3}${upspeed eth1}${color}${alignr}${color1}Down:${color} ${color3}${downspeed eth1}${color}
${upspeedgraph eth1 75,135 333333 333333}${alignr}${downspeedgraph eth1 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup eth1}${color}${alignr}${color1}Received:${color} ${color2}${totaldown eth1}${color}
${else}${if_existing /proc/net/route ppp0}
${color1}Up:${color} ${color3}${upspeed ppp0}${color}${alignr}${color1}Down:${color} ${color3}${downspeed ppp0}${color}
${upspeedgraph ppp0 75,135 333333 333333}${alignr}${downspeedgraph ppp0 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup ppp0}${color}${alignr}${color1}Received:${color} ${color2}${totaldown ppp0}${color}
${else}${if_existing /proc/net/route ppp1}
${color1}Up:${color} ${color3}${upspeed ppp1}${color}${alignr}${color1}Down:${color} ${color3}${downspeed ppp1}${color}
${upspeedgraph ppp1 75,135 333333 333333}${alignr}${downspeedgraph ppp1 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup ppp1}${color}${alignr}${color1}Received:${color} ${color2}${totaldown ppp1}${color}
${else}${if_existing /proc/net/route usb0}
${color1}Up:${color} ${color3}${upspeed usb0}${color}${alignr}${color1}Down:${color} ${color3}${downspeed usb0}${color}
${upspeedgraph usb0 75,135 333333 333333}${alignr}${downspeedgraph usb0 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup usb0}${color}${alignr}${color1}Received:${color} ${color2}${totaldown usb0}${color}
${else}${if_existing /proc/net/route usb1}
${color1}Up:${color} ${color3}${upspeed usb1}${color}${alignr}${color1}Down:${color} ${color3}${downspeed usb1}${color}
${upspeedgraph usb1 75,135 333333 333333}${alignr}${downspeedgraph usb1 75,135 333333 333333}
${color1}Sent:${color} ${color2}${totalup usb1}${color}${alignr}${color1}Received:${color} ${color2}${totaldown usb1}${color}
${else}
Network disconnected
${color6}Connect to a network to see statistics${color}
${voffset 75}
${endif}${endif}${endif}${endif}${endif}${endif}${endif}${endif}${voffset -30}
]];
