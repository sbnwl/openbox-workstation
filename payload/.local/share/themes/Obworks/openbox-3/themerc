########################################################################
#
# Openbox Workstation
# Windows 11 Inspired
# Prototype v0.3
#
########################################################################

########################################################################
# General
########################################################################

border.width:                  1

padding.width:                 14
padding.height:                9

window.handle.width:           0
window.client.padding.width:   0

menu.overlap:                  2

*.justify:                     Left


########################################################################
# Menus
########################################################################

menu.border.width:             1
menu.border.color:             #d8d8d8

menu.title.bg:                 Flat Solid
menu.title.bg.color:           #fdfdfd
menu.title.text.color:         #202020

menu.items.bg:                 Flat Solid
menu.items.bg.color:           #ffffff
menu.items.text.color:         #202020

menu.items.active.bg:          Flat Solid
menu.items.active.bg.color:    #e5f3ff
menu.items.active.text.color:  #202020

menu.separator.width:          1
menu.separator.padding.width:  6
menu.separator.padding.height: 4
menu.separator.color:          #d8d8d8


########################################################################
# Handle / Grip
########################################################################

window.*.handle.bg:            Flat Solid
window.*.handle.bg.color:      #ffffff

window.*.grip.bg:              Flat Solid
window.*.grip.bg.color:        #ffffff


########################################################################
# Shared Titlebar
########################################################################

*.title.bg:                    Flat Solid
*.title.bg.color:              #fdfdfd


########################################################################
# Active Window
########################################################################

window.active.border.color:            #d6d6d6

window.active.title.separator.color:   #fafafa

window.active.label.bg:                ParentRelative
window.active.label.text.color:        #404040

window.active.button.unpressed.bg:     ParentRelative
window.active.button.unpressed.image.color: #5a5a5a

window.active.button.hover.bg:         ParentRelative
window.active.button.hover.image.color:#303030

window.active.button.pressed.bg:       ParentRelative
window.active.button.pressed.image.color:#202020


########################################################################
# Inactive Window
########################################################################

window.inactive.border.color:          #e6e6e6

window.inactive.title.bg:              Flat Solid
window.inactive.title.bg.color:        #fdfdfd

window.inactive.title.separator.color: #f3f3f3

window.inactive.label.bg:              ParentRelative
window.inactive.label.text.color:      #808080

window.inactive.button.unpressed.bg:   ParentRelative
window.inactive.button.unpressed.image.color:#8d8d8d

window.inactive.button.hover.bg:       ParentRelative
window.inactive.button.hover.image.color:#606060

window.inactive.button.pressed.bg:     ParentRelative
window.inactive.button.pressed.image.color:#404040
