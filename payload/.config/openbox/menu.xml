<?xml version="1.0" encoding="utf-8"?>
<openbox_menu xmlns="http://openbox.org/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://openbox.org/                 file:///usr/share/openbox/menu.xsd">
	<menu id="root-menu" label="Openbox 3">
		<item label="Terminal emulator">
			<action name="Execute">
				<execute>gnome-terminal</execute>
			</action>
		</item>
		<item label="Home">
			<action name="Execute">
				<execute>nautilus --no-desktop --new-window</execute>
			</action>
		</item>
		<item label="Web browser">
			<action name="Execute">
				<execute>firefox "www.google.com"</execute>
			</action>
		</item>
		<!-- This requires the presence of the 'menu' package to work -->
		<menu id="/Debian"/>
		<separator/>
		<menu id="client-list-menu"/>
		<menu id="root-menu-334243" label="Next Login">
			<item label="Switch to Dock">
				<action name="Execute">
					<execute>sh ~/.config/openbox/menu_scripts/switch2Dock</execute>
				</action>
			</item>
			<item label="Switch to Panel">
				<action name="Execute">
					<execute>sh ~/.config/openbox/menu_scripts/switch2Panel</execute>
				</action>
			</item>
		</menu>
		<separator/>
		<item label="ObAutostart">
			<action name="Execute">
				<execute>gnome-text-editor ~/.config/openbox/autostart</execute>
			</action>
		</item>
		<item label="ObMenu">
			<action name="Execute">
				<execute>obmenu</execute>
			</action>
		</item>
		<separator/>
		<item label="ObConf">
			<action name="Execute">
				<execute>obconf</execute>
			</action>
		</item>
		<item label="Reconfigure">
			<action name="Reconfigure"/>
		</item>
		<item label="Restart">
			<action name="Restart"/>
		</item>
		<separator/>
		<item label="Lock Screen">
			<action name="Execute">
				<execute>gnome-screensaver-command --lock</execute>
			</action>
		</item>
		<item label="Screen Resolution">
			<action name="Execute">
				<execute>arandr</execute>
			</action>
		</item>
		<separator/>
		<item label="Exit">
			<action name="Exit"/>
		</item>
	</menu>
</openbox_menu>
