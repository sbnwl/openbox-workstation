# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

## Extend desktop-data search paths - Required by newer XFCE Panel
##-- versions (>=4.20) to discover Whisker Menu, launchers and other
##-- panel plugins.
export XDG_DATA_DIRS="\
/usr/share:\
/usr/local/share:\
/var/lib/snapd/desktop:\
/var/lib/flatpak/exports/share:\
${HOME}/.local/share/flatpak/exports/share:\
${XDG_DATA_DIRS}"

# -----------------------------------------------------------------------------
# Desktop services
# -----------------------------------------------------------------------------

##Disable DPMS
#xset -dpms; xset s off &

##Settings manager - Control GTK themes and all other desktop stuff
##-- Unity 7, Gnome < 44, or Gnome >= 44 
#unity-settings-daemon &
#gnome-settings-daemon &
#/usr/libexec/gsd-xsettings &

##Compositor (Picom is the default, Compton retained for compatibility)
#compton -cCGfF -o 0.38 -O 200 -I 200 -t 0 -l 0 -r 3 -D2 -m 0.88 &
#compton -CGb &
picom -b &

##Background - Randomize wallpaper on login from a folder
(sleep 1s && feh --recursive --randomize --bg-fill /usr/share/backgrounds) &

##Sound Icon - Choose either volumeicon or pasystray
#(sleep 1s && volumeicon) &
#(sleep 1s && pasystray >/dev/null 2>&1) &

##Screensaver - Evoke screensaver
(sleep 1s && gnome-screensaver) &

##Desktop Board - Conky desktop-applet for current WEATHER, TIME and RESOURCES
(sleep 3s && conky) &

## EITHER ## tint2+xfce4 panel
(sleep 0.50s && tint2) &
(sleep 0.25s && xfce4-panel) &

## OR ## Plank dock
#(sleep 0.25s && plank) &

## OR ## Cairo dock panel
#(sleep 0.25s && cairo-dock) &

##numlockx
#(sleep 1s && numlockx) &

##PolicyKit - Handle graphical authentication dialogs
(sleep 1s && ~/.config/openbox/general_scripts/launchPolkit) &

